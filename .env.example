# ─── veroliq-web environment variables ───────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# All NEXT_PUBLIC_* vars are inlined at build time and safe to expose in the browser.

# ── App URLs ──────────────────────────────────────────────────────────────────
# Where the "Sign in" nav link points.
NEXT_PUBLIC_VEROLIQ_LOGIN_URL=https://app.veroliq.com/auth/login

# Where the primary "Get started" / "Start free" CTAs point.
NEXT_PUBLIC_VEROLIQ_ONBOARDING_URL=https://app.veroliq.com/onboarding

# ── Demo widget ───────────────────────────────────────────────────────────────
# Site-id used by the live demo page (/demo) to mount the Vera AI widget.
NEXT_PUBLIC_VEROLIQ_WIDGET_SITE_ID=

# Base URL of the Veroliq API, used by the demo widget embed.
# Production: https://api.veroliq.com  |  Local dev: http://localhost:3001
NEXT_PUBLIC_VEROLIQ_WIDGET_API_BASE_URL=https://api.veroliq.com

# ── (optional) Internal API proxy ─────────────────────────────────────────────
# Only needed if veroliq-web makes direct server-side API calls (currently unused).
# NEXT_PUBLIC_VEROLIQ_API_URL=https://api.veroliq.com
